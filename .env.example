APP_PASSWORD=choose-a-strong-team-password
GEMINI_API_KEY=your-gemini-key
# Optional: comma-separated model priority order (falls back to the next on quota/overload/unknown model)
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Optional: Cloudflare Worker relay for PullPush (needed if keyword search returns 403 "Just a moment...")
# PULLPUSH_PROXY_URL=https://pullpush-relay.<your-subdomain>.workers.dev
# PULLPUSH_PROXY_KEY=same-secret-as-the-worker-RELAY_KEY
